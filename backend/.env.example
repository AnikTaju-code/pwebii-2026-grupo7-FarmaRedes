PORT=3001
JWT_SECRET=coloque_uma_chave_aleatoria_longa
PAYMENT_MODE=demo
DATA_DIR=./data
FRONTEND_ORIGIN=http://localhost:5173

# SMS reais via Twilio (configurar no Render; NUNCA publicar .env):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Em alternativa ao FROM: TWILIO_MESSAGING_SERVICE_SID=
# trial: modelos predefinidos da Twilio
# production: mensagens personalizadas
TWILIO_MODE=trial
TWILIO_SMS_TEMPLATE=sms_order_confirmation